# Authelia portal: https://${AUTH_DOMAIN}
server {
    listen 443 ssl;
    http2 on;
    server_name ${AUTH_DOMAIN};

    include /etc/nginx/conf.d/vpn-only.inc;
    # Client certificates (MTLS in ztvpn.conf); generated by initial-setup.sh.
    include /etc/nginx/snippets/mtls.conf;
    add_header Strict-Transport-Security "max-age=63072000" always;

    set $upstream_authelia_portal http://authelia:9091;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $upstream_authelia_portal;
    }
}
