# Prometheus (monitoring profile): https://prometheus.${DOMAIN}
# Access rule: configuration.yml access_control, domain prometheus.<DOMAIN>.
server {
    listen 443 ssl;
    http2 on;
    server_name prometheus.${DOMAIN};

    include /etc/nginx/conf.d/vpn-only.inc;
    # Client certificates (MTLS in ztvpn.conf); generated by initial-setup.sh.
    include /etc/nginx/snippets/mtls.conf;
    add_header Strict-Transport-Security "max-age=63072000" always;

    include /etc/nginx/snippets/authelia-location.conf;

    set $upstream_app http://prometheus:9090;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/authelia-authrequest.conf;
        proxy_pass $upstream_app;
    }
}
