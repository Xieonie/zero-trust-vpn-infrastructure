<?xml version="1.0" encoding="UTF-8"?>
<!--
  zero-trust-vpn: example pfSense rules for a perimeter firewall IN FRONT of
  the Linux VPN host. ILLUSTRATIVE ONLY.

  What this is:
    The relevant fragments of a pfSense config.xml (<aliases>, <nat>,
    <filter>) showing the rules that match the host firewall contract
    (scripts/setup/firewall-setup.sh): VPN clients (10.8.0.0/24) may reach
    only the reverse proxy on the services subnet (10.0.1.0/24, tcp/443),
    nothing else.

  What this is NOT:
    - Not a complete config.xml. Do NOT restore it with Diagnostics >
      Backup & Restore: that replaces the whole configuration.
    - Firewall > Rules has no import function.

  How to use it:
    1. Create the aliases under Firewall > Aliases (VPN_HOST = LAN/DMZ
       address of the Linux WireGuard host, VPN_CLIENTS, SERVICES).
    2. Create the port forward under Firewall > NAT > Port Forward.
    3. Create the rules under Firewall > Rules on the interface the VPN
       host is connected to (here "opt1"), in this order.
    4. Add a static route 10.8.0.0/24 via VPN_HOST (System > Routing) so
       replies reach the VPN clients without NAT, which keeps the client
       address visible to nginx/Authelia.
    Alternatively merge the elements into a config.xml backup by hand and
    restore that; review every field (interfaces, trackers) first.

  Placeholders: 192.168.10.10 (VPN host), opt1 (its interface).
  Nothing here opens the Authelia port 9091: Authelia is reached only
  through nginx on 443.
-->
<pfsense>
  <aliases>
    <alias>
      <name>VPN_HOST</name>
      <type>host</type>
      <address>192.168.10.10</address>
      <descr>Linux host running WireGuard (wg0) and the container stack</descr>
    </alias>
    <alias>
      <name>VPN_CLIENTS</name>
      <type>network</type>
      <address>10.8.0.0/24</address>
      <descr>WireGuard tunnel subnet (VPN_SUBNET)</descr>
    </alias>
    <alias>
      <name>SERVICES</name>
      <type>network</type>
      <address>10.0.1.0/24</address>
      <descr>Services subnet (SERVICES_SUBNET), reverse proxy only</descr>
    </alias>
  </aliases>

  <nat>
    <rule>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>udp</protocol>
      <source>
        <any/>
      </source>
      <destination>
        <network>wanip</network>
        <port>51820</port>
      </destination>
      <target>VPN_HOST</target>
      <local-port>51820</local-port>
      <associated-rule-id>pass</associated-rule-id>
      <descr>WireGuard to the VPN host</descr>
    </rule>
  </nat>

  <filter>
    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <statetype>keep state</statetype>
      <source>
        <address>VPN_CLIENTS</address>
      </source>
      <destination>
        <address>SERVICES</address>
        <port>443</port>
      </destination>
      <descr>VPN clients to the reverse proxy (Authelia forward auth) only</descr>
    </rule>
    <rule>
      <type>block</type>
      <interface>opt1</interface>
      <ipprotocol>inet46</ipprotocol>
      <protocol>any</protocol>
      <log/>
      <source>
        <address>VPN_CLIENTS</address>
      </source>
      <destination>
        <any/>
      </destination>
      <descr>Everything else from VPN clients (no LAN, no internet unless FULL_TUNNEL)</descr>
    </rule>
  </filter>
</pfsense>
