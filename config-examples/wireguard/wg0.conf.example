# WireGuard server configuration: /etc/wireguard/wg0.conf (mode 600).
#
# Written by scripts/setup/wireguard-setup.sh; peers are added and removed
# by scripts/management/add-user.sh / revoke-user.sh. Do not hand-edit peer
# blocks: the scripts find them by the exact "# BEGIN PEER <name>" /
# "# END PEER <name>" markers. Changes are applied without dropping
# sessions with "wg syncconf wg0 <(wg-quick strip wg0)".
#
# There are deliberately no PostUp/PostDown firewall commands and no DNS
# line: forwarding, NAT and filtering are done by the nftables table
# "inet ztvpn" (scripts/setup/firewall-setup.sh), and a server has no use
# for a DNS setting.
#
# WireGuard authenticates peers by their public key (plus the per-peer
# preshared key). Users additionally sign in to Authelia (password + second
# factor) for every protected application.

[Interface]
# wg genkey > /etc/wireguard/server_private.key
PrivateKey = <contents of /etc/wireguard/server_private.key>
Address = 10.8.0.1/24
ListenPort = 51820

# BEGIN PEER alice--laptop
[Peer]
PublicKey = <alice--laptop public key>
PresharedKey = <alice--laptop preshared key>
AllowedIPs = 10.8.0.2/32
# END PEER alice--laptop
