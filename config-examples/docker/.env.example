# Settings for docker-compose.yml, deployed as $COMPOSE_DIR/.env.
#
# scripts/setup/initial-setup.sh generates this file from
# /etc/zero-trust-vpn/ztvpn.conf; edit ztvpn.conf, not this file.
#
# NO SECRETS HERE. Every secret is a file that compose mounts:
#   $AUTHELIA_SECRETS_DIR/{jwt_secret,session_secret,storage_encryption_key,
#                          postgres_password,redis_password}
#   (created by scripts/setup/authelia-setup.sh)
#   $GRAFANA_ADMIN_PASSWORD_FILE (only for the "monitoring" profile)

COMPOSE_PROJECT_NAME=zero-trust-vpn
TZ=UTC

# Naming (Authelia cookie domain / portal URL, nginx server names)
DOMAIN=example.com
AUTH_DOMAIN=auth.example.com

# Tunnel subnet: Authelia's "vpn" network and nginx's allow list
VPN_SUBNET=10.8.0.0/24

# Host address nginx publishes 80/443 on. Must be inside SERVICES_SUBNET.
# Never 0.0.0.0: Docker-published ports bypass the host firewall.
PROXY_BIND_ADDR=10.0.1.1

# Host paths
CONFIG_PATH=/opt/zero-trust-vpn
CERTS_PATH=/opt/zero-trust-vpn/certificates
AUTHELIA_DIR=/opt/zero-trust-vpn/authelia
AUTHELIA_SECRETS_DIR=/opt/zero-trust-vpn/authelia/secrets

# Pinned Authelia image (the configuration targets 4.39)
AUTHELIA_IMAGE=authelia/authelia:4.39

# Monitoring profile only
#GRAFANA_ADMIN_PASSWORD_FILE=/etc/zero-trust-vpn/secrets/grafana_admin_password
